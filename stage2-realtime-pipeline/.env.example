# Copy this file to .env and fill in your own values. Never commit the real .env file.

# NSW FuelCheck API credentials (register at https://api.nsw.gov.au/)
FUELCHECK_API_KEY=
FUELCHECK_API_SECRET=
# Base64 "Basic <client_id:client_secret>" string used for the OAuth token request
FUELCHECK_AUTH_HEADER=

# MQTT broker used to stream cleaned records from publisher.py to dashboard.py
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=fuel/check
